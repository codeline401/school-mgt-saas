<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Helvetica', 'Arial', sans-serif; color: #1a1a1a; font-size: 10pt; }
    .header { display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid #2563eb; padding-bottom: 10px; margin-bottom: 15px; }
    .school-info h1 { font-size: 14pt; color: #2563eb; }
    .school-info p { font-size: 8pt; color: #555; }
    .logo { max-width: 60px; max-height: 60px; }
    .title { text-align: center; font-size: 16pt; font-weight: bold; margin: 12px 0; text-transform: uppercase; }
    .subtitle { text-align: center; font-size: 11pt; color: #555; margin-bottom: 15px; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0; }
    th { background: #2563eb; color: white; padding: 9px 8px; text-align: left; font-size: 9.5pt; }
    td { padding: 7px 8px; border-bottom: 1px solid #e5e7eb; font-size: 9.5pt; }
    tr:nth-child(even) { background: #f9fafb; }
    .podium-1 { background: linear-gradient(90deg, #fde68a, #fbbf24) !important; font-weight: bold; }
    .podium-2 { background: linear-gradient(90deg, #e5e7eb, #d1d5db) !important; font-weight: bold; }
    .podium-3 { background: linear-gradient(90deg, #fed7aa, #fb923c) !important; font-weight: bold; }
    .rang { font-size: 13pt; font-weight: bold; text-align: center; color: #2563eb; }
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 20px 0; }
    .stat-box { padding: 12px; background: #eff6ff; border-left: 4px solid #2563eb; border-radius: 4px; text-align: center; }
    .stat-box h3 { font-size: 8.5pt; color: #555; margin-bottom: 3px; text-transform: uppercase; }
    .stat-box .value { font-size: 18pt; font-weight: bold; color: #2563eb; }
    .stat-box .unit { font-size: 10pt; color: #666; }
    .footer { margin-top: 25px; text-align: center; font-size: 8pt; color: #666; border-top: 1px solid #ddd; padding-top: 8px; }
  </style>
</head>
<body>
  <div class="header">
    <div class="school-info">
      <h1>{{school.nom}}</h1>
      {{#if school.adresse}}<p>📍 {{school.adresse}}</p>{{/if}}
    </div>
    {{#if school.logoUrl}}<img src="{{school.logoUrl}}" class="logo">{{/if}}
  </div>

  <div class="title">Classement de la classe</div>
  <div class="subtitle">
    <strong>{{classe.nom}}</strong> — {{periode.nom}} ({{periode.anneeScolaire}})
  </div>

  <div class="stats">
    <div class="stat-box">
      <h3>Élèves classés</h3>
      <div class="value">{{entries.length}}</div>
    </div>
    <div class="stat-box">
      <h3>Moyenne classe</h3>
      <div class="value">{{moyenneClasse}}<span class="unit">/20</span></div>
    </div>
    <div class="stat-box">
      <h3>Meilleure moy.</h3>
      <div class="value" style="color:#16a34a">{{moyenneMax}}<span class="unit">/20</span></div>
    </div>
    <div class="stat-box">
      <h3>Taux de réussite</h3>
      <div class="value" style="color:{{#if (gte tauxReussite 75)}}#16a34a{{else}}{{#if (gte tauxReussite 50)}}#ea580c{{else}}#dc2626{{/if}}{{/if}}">
        {{tauxReussite}}<span class="unit">%</span>
      </div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width:8%">Rang</th>
        <th>Élève</th>
        <th style="width:12%">Moyenne</th>
        <th style="width:10%">Matières</th>
        <th>Mention</th>
      </tr>
    </thead>
    <tbody>
      {{#each entries}}
      <tr class="{{#if (eq rang 1)}}podium-1{{else}}{{#if (eq rang 2)}}podium-2{{else}}{{#if (eq rang 3)}}podium-3{{/if}}{{/if}}{{/if}}">
        <td class="rang">{{rang}}</td>
        <td><strong>{{prenom}} {{nom}}</strong></td>
        <td><strong>{{moyenne}}/20</strong></td>
        <td>{{nbMatieres}}</td>
        <td><em>{{#if mention}}{{mention}}{{else}}-{{/if}}</em></td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="footer">
    Document généré le {{formatDateLong dateGeneration}} — {{school.nom}}
  </div>
</body>
</html>
