<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    @page { size: A4; }
    body { font-family: 'Helvetica', 'Arial', sans-serif; color: #1a1a1a; font-size: 10pt; line-height: 1.4; }
    .watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 80pt; color: rgba(0,0,0,0.05); font-weight: bold; z-index: -1; pointer-events: none; }
    .header { display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid {{primaryColor}}; padding-bottom: 12px; margin-bottom: 18px; }
    .school-info h1 { font-size: 16pt; color: {{primaryColor}}; margin-bottom: 3px; }
    .school-info p { font-size: 8.5pt; color: #555; margin: 1px 0; }
    .school-info .devise { font-style: italic; color: #777; }
    .logo { max-width: 70px; max-height: 70px; }
    .title { text-align: center; font-size: 18pt; font-weight: bold; margin: 18px 0; text-transform: uppercase; letter-spacing: 1px; }
    .student-info { background: #f3f4f6; padding: 12px 15px; border-radius: 6px; margin-bottom: 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 20px; }
    .student-info p { font-size: 10pt; }
    .student-info strong { color: {{primaryColor}}; }
    table { width: 100%; border-collapse: collapse; margin: 15px 0; }
    th { background: {{primaryColor}}; color: white; padding: 8px 10px; text-align: left; font-size: 9.5pt; font-weight: bold; }
    td { padding: 7px 10px; border-bottom: 1px solid #e5e7eb; font-size: 9.5pt; }
    tr:nth-child(even) { background: #f9fafb; }
    .grade-good { color: #16a34a; font-weight: bold; }
    .grade-warn { color: #ea580c; font-weight: bold; }
    .grade-bad { color: #dc2626; font-weight: bold; }
    .summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; }
    .summary-box { padding: 12px; background: #eff6ff; border-left: 4px solid {{primaryColor}}; border-radius: 4px; text-align: center; }
    .summary-box h3 { font-size: 8.5pt; color: #555; margin-bottom: 4px; text-transform: uppercase; }
    .summary-box .value { font-size: 20pt; font-weight: bold; color: {{primaryColor}}; }
    .summary-box .sub { font-size: 9pt; color: #666; margin-top: 3px; }
    .appreciation { margin-top: 15px; padding: 12px 15px; background: #fef3c7; border-left: 4px solid #f59e0b; border-radius: 4px; font-style: italic; font-size: 10pt; }
    .appreciation strong { font-style: normal; color: #92400e; }
    .decision-box { margin-top: 15px; padding: 15px; text-align: center; background: #dcfce7; border: 2px solid #16a34a; border-radius: 6px; font-size: 12pt; font-weight: bold; color: #15803d; }
    .footer { margin-top: 30px; display: flex; justify-content: space-between; font-size: 9pt; }
    .signature { text-align: center; border-top: 1px solid #333; padding-top: 5px; width: 180px; }
    .signature small { display: block; color: #666; font-size: 8pt; }
  </style>
</head>
<body>
  {{#if watermark}}<div class="watermark">{{watermark}}</div>{{/if}}

  <div class="header">
    <div class="school-info">
      <h1>{{school.nom}}</h1>
      {{#if school.devise}}<p class="devise">"{{school.devise}}"</p>{{/if}}
      {{#if school.adresse}}<p>📍 {{school.adresse}}</p>{{/if}}
      {{#if school.telephone}}<p>📞 {{school.telephone}}</p>{{/if}}
      {{#if school.email}}<p>✉ {{school.email}}</p>{{/if}}
    </div>
    {{#if school.logoUrl}}<img src="{{school.logoUrl}}" class="logo" alt="logo">{{/if}}
  </div>

  <div class="title">{{config.enteteTexte}}</div>

  <div class="student-info">
    <p><strong>Élève :</strong> {{eleve.prenom}} {{eleve.nom}}</p>
    <p><strong>Classe :</strong> {{classe.nom}}</p>
    {{#if eleve.dateNaissance}}<p><strong>Né(e) le :</strong> {{formatDate eleve.dateNaissance}}</p>{{/if}}
    <p><strong>Période :</strong> {{periode.nom}} — {{periode.anneeScolaire}}</p>
    <p><strong>Effectif :</strong> {{totalEleves}} élèves</p>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 35%">Matière</th>
        {{#if config.showCoef}}<th style="width: 10%">Coef</th>{{/if}}
        <th style="width: 12%">Moyenne</th>
        {{#if config.showNbEval}}<th style="width: 10%">Nb. Eval</th>{{/if}}
        {{#if config.showRang}}<th style="width: 10%">Rang</th>{{/if}}
        <th>Appréciation</th>
      </tr>
    </thead>
    <tbody>
      {{#each subjects}}
      <tr>
        <td><strong>{{nom}}</strong></td>
        {{#if ../config.showCoef}}<td>{{coefficient}}</td>{{/if}}
        <td class="{{#if (gte moyenne ../config.seuilBien)}}grade-good{{else}}{{#if (gte moyenne ../config.seuilPassable)}}grade-warn{{else}}grade-bad{{/if}}{{/if}}">
          {{moyenne}}/20
        </td>
        {{#if ../config.showNbEval}}<td>{{nbEvaluations}}</td>{{/if}}
        {{#if ../config.showRang}}<td>{{#if rang}}{{rang}}{{#if ../totalEleves}}/{{../totalEleves}}{{/if}}{{else}}-{{/if}}</td>{{/if}}
        <td><em>{{#if appreciation}}{{appreciation}}{{else}}-{{/if}}</em></td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="summary">
    <div class="summary-box">
      <h3>Moyenne générale</h3>
      <div class="value">{{moyenneGenerale}}/20</div>
      <div class="sub">{{grade moyenneGenerale}}</div>
    </div>
    {{#if rang}}
    <div class="summary-box">
      <h3>Rang</h3>
      <div class="value">{{rang}}<small style="font-size:14pt">/{{totalEleves}}</small></div>
      <div class="sub">de la classe</div>
    </div>
    {{/if}}
    {{#if mention}}
    <div class="summary-box">
      <h3>Mention</h3>
      <div class="value" style="font-size:13pt">{{mentionLabel mention}}</div>
    </div>
    {{/if}}
  </div>

  {{#if appreciationConseil}}
  <div class="appreciation">
    <strong>Appréciation du conseil de classe :</strong> {{appreciationConseil}}
  </div>
  {{/if}}

  {{#if avertissement}}
  <div class="appreciation" style="background:#fee2e2;border-color:#dc2626">
    <strong style="color:#991b1b">{{avertissementLabel avertissement}}</strong>
  </div>
  {{/if}}

  {{#if decision}}
  <div class="decision-box">
    Décision du conseil : {{decisionLabel decision}}
  </div>
  {{/if}}

  <div class="footer">
    <div class="signature">Le professeur principal<small>Date : {{formatDate dateGeneration}}</small></div>
    <div class="signature">Le directeur<small>Cachet de l'établissement</small></div>
  </div>
</body>
</html>
