<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>Relevé - {{eleve.prenom}} {{eleve.nom}}</title>
    <style>
      @page {
        margin: 0;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: "Helvetica Neue", Arial, sans-serif;
        font-size: 11px;
        color: #1a1a1a;
        padding: 24px 28px;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 3px solid #2563eb;
        padding-bottom: 14px;
        margin-bottom: 18px;
      }
      .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .header-left img {
        height: 50px;
        width: auto;
        object-fit: contain;
      }
      .school-name {
        font-size: 15px;
        font-weight: 700;
        color: #2563eb;
      }
      .school-meta {
        font-size: 9px;
        color: #666;
        margin-top: 2px;
      }

      .title-bar {
        background: #2563eb;
        color: #fff;
        text-align: center;
        padding: 8px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 16px;
        letter-spacing: 0.5px;
      }

      .student-info {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        background: #f7f7f8;
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 16px;
        font-size: 10px;
      }
      .student-info .label {
        color: #888;
        font-size: 8px;
        text-transform: uppercase;
      }
      .student-info .value {
        font-weight: 600;
        margin-top: 1px;
      }

      .matiere-block {
        margin-bottom: 14px;
        page-break-inside: avoid;
      }
      .matiere-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #eef2ff;
        padding: 6px 10px;
        border-radius: 4px 4px 0 0;
      }
      .matiere-name {
        font-weight: 700;
        font-size: 11px;
      }
      .matiere-moy {
        font-weight: 700;
        font-size: 11px;
        color: #2563eb;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }
      thead th {
        background: #f7f7f8;
        font-size: 9px;
        text-transform: uppercase;
        color: #666;
        padding: 5px 10px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      thead th.center,
      tbody td.center {
        text-align: center;
      }
      tbody td {
        padding: 5px 10px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 10px;
      }

      .summary {
        display: flex;
        justify-content: center;
        gap: 40px;
        background: #f7f7f8;
        border-radius: 8px;
        padding: 14px;
        margin-top: 18px;
      }
      .summary-item {
        text-align: center;
      }
      .summary-item .big {
        font-size: 20px;
        font-weight: 800;
        color: #2563eb;
      }
      .summary-item .small {
        font-size: 9px;
        color: #888;
        text-transform: uppercase;
        margin-top: 2px;
      }

      .footer {
        margin-top: 24px;
        text-align: center;
        font-size: 9px;
        color: #999;
      }
    </style>
  </head>
  <body>

    <div class="header">
      <div class="header-left">
        {{#if school.logoUrl}}<img src="{{school.logoUrl}}" alt="logo" />{{/if}}
        <div>
          <div class="school-name">{{school.nom}}</div>
          {{#if school.adresse}}<div
              class="school-meta"
            >{{school.adresse}}</div>{{/if}}
        </div>
      </div>
      <div class="school-meta">Relevé généré le
        {{formatDate dateGeneration}}</div>
    </div>

    <div class="title-bar">
      RELEVÉ DE NOTES &mdash;
      {{periode.nom}}
      &mdash;
      {{periode.anneeScolaire}}
    </div>

    <div class="student-info">
      <div>
        <div class="label">Élève</div>
        <div class="value">{{eleve.prenom}} {{eleve.nom}}</div>
      </div>
      <div>
        <div class="label">Classe</div>
        <div class="value">{{classe.nom}}</div>
      </div>
      <div>
        <div class="label">Total élèves</div>
        <div class="value">{{totalEleves}}</div>
      </div>
    </div>

    {{#each matieres}}
      <div class="matiere-block">
        <div class="matiere-header">
          <span class="matiere-name">{{this.nom}}
            <span style="font-weight:400; color:#888;">(coef.
              {{this.coefficient}})</span></span>
          <span class="matiere-moy">{{this.moyenne}}/20</span>
        </div>
        <table>
          <thead>
            <tr>
              <th>Évaluation</th>
              <th class="center">Type</th>
              <th class="center">Date</th>
              <th class="center">Note</th>
              <th class="center">Sur 20</th>
              <th class="center">Coef.</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.evaluations}}
              <tr>
                <td>{{this.titre}}</td>
                <td class="center">{{this.type}}</td>
                <td class="center">{{formatDate this.date}}</td>
                <td class="center">{{this.note}}/{{this.noteMax}}</td>
                <td class="center">{{this.noteNormalisee}}/20</td>
                <td class="center">{{this.coefficient}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{/each}}

    <div class="summary">
      <div class="summary-item">
        <div class="big">{{moyenneGenerale}}/20</div>
        <div class="small">Moyenne générale</div>
      </div>
      <div class="summary-item">
        <div class="big">{{grade moyenneGenerale}}</div>
        <div class="small">Mention</div>
      </div>
      {{#if rang}}
        <div class="summary-item">
          <div class="big">{{rang}}<sup style="font-size:10px;">e</sup></div>
          <div class="small">Rang</div>
        </div>
      {{/if}}
    </div>

    <div class="footer">
      Document généré le
      {{formatDate dateGeneration}}
    </div>

  </body>
</html>