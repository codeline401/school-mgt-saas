// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Ajout d'énumération des rôles
enum Role {
  SUDO_ADMIN
  ADMIN
  USER
  PROF
  ELEVE
  PARENT
}

model User {
  id       String @id @default(uuid())
  nom      String
  prenom   String
  email    String @unique
  password String
  role     Role   @default(USER)

  // Le Sudo_Admin n'a pas de schoolId, les autres OUI.
  schoolId String? // nullable pour le Sudo_Admin
  school   School? @relation(fields: [schoolId], references: [id])

  // -- Champs profil ajoutés
  telephone     String?
  adresse       String? // Adresse postale
  dateNaissance DateTime? // Date de naissance
  photoUrl      String? // URL de la photo de profil

  // Relations vers les dossiers liés à cet utilisateur
  contrats      Contrat[] // Contrat (pour prof / collaborateur)
  remplacements Remplacement[] @relation("Remplacant") // pour les remplacements où cet utilisateur est le remplaçant
  notes         Note[]         @relation("NotesCreees") // Notes créées par ce professeur
  professeur    Professeur? // Profil RH si l'utilisateur est un PROF
  documents     Document[]     @relation("DocumentsUploades") // Documents uploadés par cet utilisateur

  parent        Parent? // Profil de parent si l'utilisateur est un PARENT
  notifications Notification[] // Notifications reçues par cet utilisateur
}

// Modele SAAS

model School {
  id  String @id @default(uuid())
  nom String // Display name only — not globally unique; can be renamed freely

  // Stable technical tenant identifier (never changes after creation)
  tenantKey String @unique @default(cuid())

  // Code unique généré automatiquement que l'ADMIN partagera à ses collaborateurs
  inviteCode String @unique @default(cuid())

  classes           Classe[]
  eleves            Eleve[]
  profs             Professeur[]
  createdAt         DateTime           @default(now())
  users             User[]
  parents           Parent[]
  dossierAdmissions DossierAdmission[]
  contrats          Contrat[]
  remplacements     Remplacement[]

  matieres         Matiere[] // Liste des matières enseignées dans l'école
  notes            Note[]
  documents        Document[]
  creneauHoraires  CreneauHoraire[]
  appels           Appel[]
  notifications    Notification[]
  cahierTextes     CahierTexte[]
  quizzes          Quiz[]
  bulletinTemplate BulletinTemplate?
}

model Classe {
  id       String       @id @default(uuid())
  nom      String // ex: "6ème A", "5ème B", etc.
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id])
  eleves   Eleve[] // Une classe a plusieurs élèves
  profs    Professeur[] // Une classe a plusieurs professeurs

  matieres Matiere[] // Matières enseignées dans cette classe

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notes           Note[]
  documents       Document[]
  creneauHoraires CreneauHoraire[]
  appels          Appel[]
  cahierTextes    CahierTexte[]
  quizzes         Quiz[]

  @@unique([schoolId, nom]) // Un nom de classe unique par école (pour les upserts)
}

model Eleve {
  id       String @id @default(uuid())
  nom      String
  prenom   String
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  classeId String
  classe   Classe @relation(fields: [classeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -- Champs profil ajoutés
  dateNaissance DateTime? // Date de naissance
  telephone     String?
  adresse       String?
  photoUrl      String? // URL de la photo de profil

  // Relation vers le parent responsable
  parentId String?

  // Historique des admissions de l'élève
  admissions  DossierAdmission[]
  parent      Parent?            @relation(fields: [parentId], references: [id])
  notes       Note[]
  presences   Presence[]
  soumissions Soumission[]

  @@unique([schoolId, nom, prenom]) // Nom + prénom unique par école (pour les upserts)
  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([classeId]) // Index pour optimiser les requêtes par classe
  @@index([parentId]) // lookup parent + enfants
}

model Professeur {
  id       String   @id @default(uuid())
  nom      String
  prenom   String
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  classes  Classe[] // Un professeur peut enseigner dans plusieurs classes

  // Lien vers le compte User du professeur (pour le filtrage par utilisateur connecté)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Matières que ce professeur enseigne (pour filtrer les matières dans les notes)
  matieres Matiere[] @relation("ProfesseurMatieres")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -- champs profil ajoutés
  telephone     String?
  adresse       String? // Adresse postale
  dateNaissance DateTime? // Date de naissance
  photoUrl      String? // URL de la photo de profil
  specialites   String? // Matières enseignées, ex: "Mathématiques, Physique"

  // Relation dossier RH
  contrat       Contrat[]
  remplacements Remplacement[] @relation("ProfesseurAbsent") // Remplacement assuré par ce professeur
  cahierTextes  CahierTexte[]
  quizzes       Quiz[]

  @@unique([schoolId, nom, prenom]) // Nom + prénom unique par école (pour les upserts)
  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([userId]) // Index pour optimiser les requêtes par userId
}

// MODELE PARENT 
// Découplé de USER - un parent peut ne pas avoir de compte
model Parent {
  id        String  @id @default(uuid())
  nom       String
  prenom    String
  email     String? // Un parent peut ne pas avoir d'email
  telephone String? // Un parent peut ne pas avoir de téléphone
  adresse   String? // Un parent peut ne pas avoir d'adresse
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // peut avoir plusieurs enfants dans l'école
  eleves Eleve[]

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId]) // Index pour optimiser les requêtes par école
}

// MODELE DOSSIER D'ADMISSION - nouveau
// Gère les demandes d'inscription et la liste d'attente
model DossierAdmission {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Information sur le candidat
  nomEleve      String
  prenomEleve   String
  dateNaissance DateTime
  classeVisee   String // ex: "6ème", "5ème", etc.
  adresse       String?

  // Contact parent / tuteur
  nomParent       String
  prenomParent    String
  telephoneParent String
  emailParent     String?

  // Statut du dossier
  statut StatutAdmission @default(EN_ATTENTE)

  // Si admis, on peut lier à l'élève créé
  eleveId String? @unique
  eleve   Eleve?  @relation(fields: [eleveId], references: [id])

  // Note interne de l'admin
  notesAdmin String?

  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([statut]) // filtre par statut (EN_ATTENTE, ADMIS, etc.)
}

// Status possibles d'un dossier d'admission
enum StatutAdmission {
  EN_ATTENTE // dossier reçu mais pas encore traité
  EN_LISTE_ATTENTE // dossier retenu mais en liste d'attente
  ADMIS // dossier accepté, élève admis
  REFUSE // dossier refusé
}

// MODELE CONTRAT - 
// Dossier admin d'un membre personnel (prof ou collaborateur)
model Contrat {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  typeContrat  TypeContrat // ex: "CDI", "CDD", "Vacataire"
  dateDebut    DateTime
  dateFin      DateTime?
  poste        String // ex: "Professeur de Mathématiques", "Agent d'entretien", etc.
  salaire      Decimal? // optionnel, peut être négocié ou non divulgué
  // lien soit à un prof, soit à un user (collaborateur administratif)
  professeurId String?
  professeur   Professeur? @relation(fields: [professeurId], references: [id])
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])

  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([professeurId]) // Index pour optimiser les requêtes par professeur
  @@index([userId]) // Index pour optimiser les requêtes par collaborateur
}

enum TypeContrat {
  CDI
  CDD
  VACATAIRE
  STAGIAIRE
}

// MODELE REMPLACEMENT -
// Suivi des remplacements de professeurs absents
model Remplacement {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date  DateTime // date du remplacement
  motif String? // raison de l'absence du prof titulaire

  // Professeur absent
  professeurAbsentId String
  professeurAbsent   Professeur @relation("ProfesseurAbsent", fields: [professeurAbsentId], references: [id], onDelete: Cascade)

  // Remplaçant
  remplacantUserId String?
  remplacant       User?   @relation("Remplacant", fields: [remplacantUserId], references: [id])

  // Classe concernée par le remplacement
  classeNom String? // ex: "6ème A", "5ème B", etc.

  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([professeurAbsentId]) // Index pour optimiser les requêtes par professeur absent
  @@index([date]) // Index pour optimiser les requêtes par date
}

model Matiere {
  id              String           @id @default(uuid())
  nom             String // ex: "Mathématiques", "Français", etc.
  description     String? // description optionnelle de la matière
  classeId        String // la classe à laquelle cette matière est associée
  classe          Classe           @relation(fields: [classeId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notes           Note[]
  profs           Professeur[]     @relation("ProfesseurMatieres") // Profs qui enseignent cette matière
  documents       Document[]
  creneauHoraires CreneauHoraire[]
  cahierTextes    CahierTexte[]
  quizzes         Quiz[]

  @@unique([classeId, nom]) // Un nom de matière unique par classe
  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([classeId]) // Index pour optimiser les requêtes par classe
}

// apps/api/prisma/schema.prisma

/// Note — enregistre la note d'un élève pour une matière et une évaluation données.
///
/// Un élève peut avoir PLUSIEURS notes pour la même matière, chacune distinguée
/// par un titre d'évaluation (ex: "1er DS - 1er Trimestre - 2026-2027").
///
/// Contraintes :
///   - Unique sur (eleveId, matiereId, titre) : même élève, même matière, même éval → doublon.
///   - note ≤ noteMax validé dans le contrôleur.
///   - feuillePath : chemin local du fichier corrigé uploadé (optionnel).
///   - createdById : utilisateur PROF qui a saisi la note.
model Note {
  id          String  @id @default(uuid())
  titre       String // ex: "1er DS - 1er Trimestre - 2026-2027"
  note        Decimal
  noteMax     Decimal @default(20) // note maximale possible, par défaut 20
  coefficient Decimal @default(1) // coefficient de la note, par défaut 1
  commentaire String?
  feuillePath String? // chemin local du fichier corrigé uploadé (optionnel) 

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Professeur qui a saisi la note
  createdById String
  createdBy   User   @relation("NotesCreees", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eleveId, matiereId, titre]) // Un élève ne peut avoir qu'une note par matière et par titre d'évaluation
  @@index([classeId]) // Index pour optimiser les requêtes par classe
  @@index([matiereId]) // Index pour optimiser les requêtes par matière
  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([eleveId]) // Index pour optimiser les requêtes par élève
}

// ── MODULE DOCUMENTS ─────────────────────────────────────────────────────────

enum TypeDocument {
  COURS
  DEVOIR
  EVALUATION
  NOTE_SERVICE
  CIRCULAIRE
  AUTRE
}

model Document {
  id          String       @id @default(uuid())
  titre       String
  description String?
  type        TypeDocument
  filePath    String
  mimeType    String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("DocumentsUploades", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classeId])
  @@index([uploadedById])
  @@index([type])
}

// MODULE EMPLOI DU TEMPS
enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

model CreneauHoraire {
  id         String      @id @default(uuid())
  classeId   String
  classe     Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  jour       JourSemaine
  heureDebut String // format "HH:mm", ex: "08:30"
  heureFin   String // format "HH:mm", ex: "10:00"
  intitule   String? // ex: "Mathématiques - M. Dupont"
  matiereId  String?
  matiere    Matiere?    @relation(fields: [matiereId], references: [id])
  couleur    String? // couleur personnalisée pour le créneau (ex: "#FF5733")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appels    Appel[]

  @@unique([classeId, jour, heureDebut, heureFin]) // Un créneau unique par classe, jour et heure de début
  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([classeId]) // Index pour optimiser les requêtes par classe
}

// MODULE ABSENCE / APPELS
enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
}

/// Un appel = une session de présence pour un creneau horaire à une date donnée
model Appel {
  id        String @id @default(uuid())
  creneauId String
  classeId  String
  schoolId  String
  /// Date au format "YYYY-MM-DD", ex: "2024-09-01"
  date      String

  creneau   CreneauHoraire @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  classe    Classe         @relation(fields: [classeId], references: [id], onDelete: Cascade)
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  presences Presence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creneauId, date]) // Un appel unique par créneau et par date
  @@index([schoolId]) // Index pour optimiser les requêtes par école
  @@index([classeId]) // Index pour optimiser les requêtes par classe
}

/// Présence d'un élève dans un appel
model Presence {
  id      String         @id @default(uuid())
  appelId String
  eleveId String
  statut  StatutPresence

  appel Appel @relation(fields: [appelId], references: [id], onDelete: Cascade)
  eleve Eleve @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([appelId, eleveId]) // Un enregistrement de présence unique par appel et par élève
}

// MODELE NOTIFICATION - Pour gérer les notifications aux parents etc
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  message   String
  lien      String? // ex: "/classes/:id" pour naviguer au cliec
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, lu])
}

// CAHIER DE TEXTE, QUIZ pour professeur
enum StatutQuiz {
  BROUILLON
  PUBLIE
  FERME
}

enum TypeQuestion {
  QCM
  VRAI_FAUX
  REPONSE_COURTE
}

model CahierTexte {
  id           String   @id @default(uuid())
  titre        String
  detail       String?  @db.Text // description détaillée du cours, devoir, etc.
  date         String // YYYY-MM-DD
  classeId     String
  matiereId    String?
  professeurId String // le prof qui a créé ce cahier de texte
  schoolId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classe     Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere    Matiere?   @relation(fields: [matiereId], references: [id], onDelete: SetNull)
  professeur Professeur @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  devoir     Devoir[]

  @@index([classeId, date]) // pour optimiser les requêtes par classe et par date
  @@index([professeurId]) // pour optimiser les requêtes par professeur
}

model Devoir {
  id            String   @id @default(uuid())
  titre         String
  description   String?  @db.Text
  dateRendu     String // YYYY-MM-DD
  cahierTexteId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cahierTexte CahierTexte @relation(fields: [cahierTexteId], references: [id], onDelete: Cascade)

  @@index([cahierTexteId]) // pour optimiser les requêtes par cahier de texte
}

model Quiz {
  id           String     @id @default(uuid())
  titre        String
  classeId     String
  matiereId    String?
  professeurId String
  schoolId     String
  statut       StatutQuiz @default(BROUILLON)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  classe      Classe       @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere     Matiere?     @relation(fields: [matiereId], references: [id], onDelete: SetNull)
  professeur  Professeur   @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  questions   Question[]
  soumissions Soumission[]

  @@index([classeId]) // pour optimiser les requêtes par classe
  @@index([professeurId]) // pour optimiser les requêtes par professeur
}

model Question {
  id           String       @id @default(uuid())
  quizId       String
  enonce       String       @db.Text
  type         TypeQuestion
  options      String[] // pour les QCM, stocke les options de réponse
  bonneReponse String // pour les QCM, stocke la bonne réponse (ex: "A", "B", etc.) ou la réponse correcte pour les autres types
  ordre        Int          @default(0) // pour ordonner les questions dans le quiz
  createdAt    DateTime     @default(now())

  quiz     Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  reponses Reponse[]

  @@index([quizId])
}

model Soumission {
  id       String   @id @default(uuid())
  quizId   String
  eleveId  String
  score    Float? // score obtenu, calculé après correction
  total    Int
  soumisAt DateTime @default(now())

  quiz     Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  eleve    Eleve     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  reponses Reponse[]

  @@unique([quizId, eleveId]) // Un élève ne peut soumettre qu'une fois par quiz
}

model Reponse {
  id           String   @id @default(uuid())
  soumissionId String
  questionId   String
  valeur       String // la réponse donnée par l'élève (ex: "A", "B", "C", "D" pour les QCM, ou la réponse textuelle pour les autres types)
  correcte     Boolean? // indique si la réponse est correcte, calculée après correction

  soumission Soumission @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([soumissionId, questionId]) // Une réponse unique par question dans une soumission
}

// --- MODULE BULLETIN TEMPLATE (pour générer les bulletins de notes) ---

/// Canevas personnalisé du bulletin scolaire.
/// Il est unique par école (relation @unique sur schoolId).
/// La configuration est stockée en JSON pour rester extensible sans migration.

/// Champs JSON (BulletinTemplateConfig) :
/// - enteteTexte     : texte affcihé en haut du bulletin (ex: "Bulletin de Notes - Année 2026-2027")
/// - anneeTexte      : année scolaire affichée (ex: "2026-2027")
/// - piedTexte       : pied de page, ligne de signature
/// - showRang        : afficher la colonne coefficient dans le tableau
/// - showCoef        : afficher la colonne coefficient dans le tableau
/// - showNbEval      : afficher le nombre d'évaluations par matière
/// - seuilBien       : note minimale pour la couleur "Bien" (défaut : 14)
/// - seuiAssezBien   : note minimale pour la couleur "Assez Bien" (défaut : 12)
/// - seuilPassable   : note minimale poue la couleur "Passable" (défaut : 10)
model BulletinTemplate {
  id       String @id @default(uuid())
  schoolId String @unique // Un seul canevas par école
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // JSON sérialisé de BulletinTemplateConfig (voir packages/types/index.ts)
  config Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId]) // Index pour optimiser les requêtes par école
}
