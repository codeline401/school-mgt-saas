generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Ajout d'énumération des rôles
enum Role {
  SUDO_ADMIN
  ADMIN
  USER
  PROF
  ELEVE
  PARENT
}

model User {
  id       String @id @default(uuid())
  nom      String
  prenom   String
  email    String @unique
  password String
  role     Role   @default(USER)

  // Le Sudo_Admin n'a pas de schoolId, les autres OUI.
  schoolId String? // nullable pour le Sudo_Admin
  school   School? @relation(fields: [schoolId], references: [id])

  // -- Champs profil ajoutés
  telephone     String?
  adresse       String?
  dateNaissance DateTime?
  photoUrl      String?

  // Relations
  contrats                      Contrat[]
  remplacements                 Remplacement[]        @relation("Remplacant")
  notes                         Note[]                @relation("NotesCreees")
  professeur                    Professeur?
  documents                     Document[]            @relation("DocumentsUploades")
  parent                        Parent?
  notifications                 Notification[]
  deliberationSessions          DeliberationSession[] @relation("DelibCreatedBy")
  deliberationSessionsValidées DeliberationSession[] @relation("DelibValidatedBy")
  examensCrees                  ExamenSession[]       @relation("ExamensCrees")
  examenSurveillances           ExamenSurveillance[]  @relation("ExamenSurveilles")
  examenIncidents               ExamenIncident[]      @relation("ExamenIncidentsCrees")
  signature                     Signature?
  reservationSalles             ReservationSalle[]
  mouvementStocks               MouvementStock[]
}

// Modele SAAS

model School {
  id         String @id @default(uuid())
  nom        String
  tenantKey  String @unique @default(cuid())
  inviteCode String @unique @default(cuid())

  // -- Champs contact école (pour les exports PDF)
  adresse         String?
  telephone       String?
  email           String?
  logoUrl         String?
  devise          String?
  slogan          String?
  siteWeb         String?
  numAutorisation String?

  classes              Classe[]
  eleves               Eleve[]
  profs                Professeur[]
  createdAt            DateTime              @default(now())
  users                User[]
  parents              Parent[]
  dossierAdmissions    DossierAdmission[]
  contrats             Contrat[]
  remplacements        Remplacement[]
  matieres             Matiere[]
  notes                Note[]
  documents            Document[]
  creneauHoraires      CreneauHoraire[]
  appels               Appel[]
  notifications        Notification[]
  cahierTextes         CahierTexte[]
  quizzes              Quiz[]
  bulletinTemplate     BulletinTemplate?
  deliberationSessions DeliberationSession[]
  examenSalles         ExamenSalle[]
  examenSessions       ExamenSession[]

  // -- Périodes scolaires de l'école
  periodes          Periode[]
  chapitres         Chapitre[]
  batiments         Batiment[]
  salles            Salle[]
  reservationSalles ReservationSalle[]
  articleStocks     ArticleStock[]
  mouvementStocks   MouvementStock[]
}

model Classe {
  id       String       @id @default(uuid())
  nom      String
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id])
  eleves   Eleve[]
  profs    Professeur[]
  matieres Matiere[]

  // NOUVEAU : professeur principal désigné pour cette classe (optionnel)
  // Utilisé pour déterminer qui signe le bulletin côté "professeur".
  professeurPrincipalId String?
  professeurPrincipal   Professeur? @relation("ProfesseurPrincipalDe", fields: [professeurPrincipalId], references: [id], onDelete: SetNull)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  notes                Note[]
  documents            Document[]
  creneauHoraires      CreneauHoraire[]
  appels               Appel[]
  cahierTextes         CahierTexte[]
  quizzes              Quiz[]
  deliberationSessions DeliberationSession[]
  examenSessions       ExamenSession[]
  chapitres            Chapitre[]
  salles               Salle[]

  @@unique([schoolId, nom])
  @@index([professeurPrincipalId])
}

model Eleve {
  id       String @id @default(uuid())
  nom      String
  prenom   String
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  classeId String
  classe   Classe @relation(fields: [classeId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dateNaissance DateTime?
  telephone     String?
  adresse       String?
  photoUrl      String?
  parentId      String?

  admissions            DossierAdmission[]
  parent                Parent?                @relation(fields: [parentId], references: [id])
  notes                 Note[]
  presences             Presence[]
  soumissions           Soumission[]
  deliberationDecisions DeliberationDecision[]

  @@unique([schoolId, nom, prenom])
  @@index([schoolId])
  @@index([classeId])
  @@index([parentId])
}

model Professeur {
  id                    String   @id @default(uuid())
  nom                   String
  prenom                String
  schoolId              String
  school                School   @relation(fields: [schoolId], references: [id])
  classes               Classe[]
  classesPrincipalesDes Classe[] @relation("ProfesseurPrincipalDe")

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  matieres Matiere[] @relation("ProfesseurMatieres")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  telephone     String?
  adresse       String?
  dateNaissance DateTime?
  photoUrl      String?
  specialites   String?

  contrat       Contrat[]
  remplacements Remplacement[] @relation("ProfesseurAbsent")
  cahierTextes  CahierTexte[]
  quizzes       Quiz[]

  @@unique([schoolId, nom, prenom])
  @@index([schoolId])
  @@index([userId])
}

model Parent {
  id        String  @id @default(uuid())
  nom       String
  prenom    String
  email     String?
  telephone String?
  adresse   String?
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eleves Eleve[]

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

model DossierAdmission {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nomEleve        String
  prenomEleve     String
  dateNaissance   DateTime
  classeVisee     String
  adresse         String?
  nomParent       String
  prenomParent    String
  telephoneParent String
  emailParent     String?

  statut  StatutAdmission @default(EN_ATTENTE)
  eleveId String?         @unique
  eleve   Eleve?          @relation(fields: [eleveId], references: [id])

  notesAdmin String?

  @@index([schoolId])
  @@index([statut])
}

enum StatutAdmission {
  EN_ATTENTE
  EN_LISTE_ATTENTE
  ADMIS
  REFUSE
}

model Contrat {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  typeContrat  TypeContrat
  dateDebut    DateTime
  dateFin      DateTime?
  poste        String
  salaire      Decimal?
  professeurId String?
  professeur   Professeur? @relation(fields: [professeurId], references: [id])
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([professeurId])
  @@index([userId])
}

enum TypeContrat {
  CDI
  CDD
  VACATAIRE
  STAGIAIRE
}

model Remplacement {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date  DateTime
  motif String?

  professeurAbsentId String
  professeurAbsent   Professeur @relation("ProfesseurAbsent", fields: [professeurAbsentId], references: [id], onDelete: Cascade)

  remplacantUserId String?
  remplacant       User?   @relation("Remplacant", fields: [remplacantUserId], references: [id])

  classeNom String?

  @@index([schoolId])
  @@index([professeurAbsentId])
  @@index([date])
}

model Matiere {
  id          String  @id @default(uuid())
  nom         String
  description String?
  classeId    String
  classe      Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notes           Note[]
  profs           Professeur[]     @relation("ProfesseurMatieres")
  documents       Document[]
  creneauHoraires CreneauHoraire[]
  cahierTextes    CahierTexte[]
  quizzes         Quiz[]
  examenSessions  ExamenSession[]
  chapitres       Chapitre[]

  @@unique([classeId, nom])
  @@index([schoolId])
  @@index([classeId])
}

// ── MODULE PÉRIODES SCOLAIRES ─────────────────────────────────────────────────
// Une période est un découpage de l'année scolaire (trimestre, semestre…)
// défini au niveau de l'école. Elle sert à regrouper les notes et générer
// les bulletins / relevés / classements par période.

enum TypePeriode {
  TRIMESTRE
  SEMESTRE
  ANNEE
  AUTRE
}

model Periode {
  id            String      @id @default(uuid())
  nom           String // ex: "Trimestre 1", "Semestre 2"
  type          TypePeriode @default(TRIMESTRE)
  anneeScolaire String // ex: "2026-2027"
  dateDebut     DateTime? // optionnel — permet le filtrage par date
  dateFin       DateTime?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations : notes et sessions de délibération liées à cette période
  notes                Note[]
  deliberationSessions DeliberationSession[]

  @@unique([schoolId, nom, anneeScolaire]) // Une période unique par école, nom et année
  @@index([schoolId])
  @@index([anneeScolaire])
}

enum TypeNote {
  INTERROGATION
  DS
  EXAMEN
  AUTRE
}

model Note {
  id          String   @id @default(uuid())
  titre       String
  note        Decimal
  noteMax     Decimal  @default(20)
  coefficient Decimal  @default(1)
  typeNote    TypeNote @default(AUTRE)
  dateEval    DateTime @default(now())
  commentaire String?
  feuillePath String?

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // -- Lien optionnel vers la période (null = note hors période formelle)
  periodeId String?
  periode   Periode? @relation(fields: [periodeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("NotesCreees", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eleveId, matiereId, titre])
  @@index([classeId])
  @@index([matiereId])
  @@index([schoolId])
  @@index([eleveId])
  @@index([typeNote])
  @@index([dateEval])
  @@index([periodeId]) // Index pour optimiser les requêtes par période
}

// ── MODULE DOCUMENTS ─────────────────────────────────────────────────────────

enum TypeDocument {
  COURS
  DEVOIR
  EVALUATION
  NOTE_SERVICE
  CIRCULAIRE
  AUTRE
}

model Document {
  id          String       @id @default(uuid())
  titre       String
  description String?
  type        TypeDocument
  filePath    String
  mimeType    String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("DocumentsUploades", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classeId])
  @@index([uploadedById])
  @@index([type])
}

// MODULE EMPLOI DU TEMPS
enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

model CreneauHoraire {
  id         String      @id @default(uuid())
  classeId   String
  classe     Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  jour       JourSemaine
  heureDebut String
  heureFin   String
  intitule   String?
  matiereId  String?
  matiere    Matiere?    @relation(fields: [matiereId], references: [id])
  couleur    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appels    Appel[]

  @@unique([classeId, jour, heureDebut, heureFin])
  @@index([schoolId])
  @@index([classeId])
}

// MODULE ABSENCE / APPELS
enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
}

model Appel {
  id        String @id @default(uuid())
  creneauId String
  classeId  String
  schoolId  String
  date      String

  creneau   CreneauHoraire @relation(fields: [creneauId], references: [id], onDelete: Cascade)
  classe    Classe         @relation(fields: [classeId], references: [id], onDelete: Cascade)
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  presences Presence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creneauId, date])
  @@index([schoolId])
  @@index([classeId])
}

model Presence {
  id      String         @id @default(uuid())
  appelId String
  eleveId String
  statut  StatutPresence

  appel Appel @relation(fields: [appelId], references: [id], onDelete: Cascade)
  eleve Eleve @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([appelId, eleveId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  message   String
  lien      String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, lu])
}

enum StatutQuiz {
  BROUILLON
  PUBLIE
  FERME
}

enum TypeQuestion {
  QCM
  VRAI_FAUX
  REPONSE_COURTE
}

model CahierTexte {
  id           String   @id @default(uuid())
  titre        String
  detail       String?  @db.Text
  date         String
  classeId     String
  matiereId    String?
  professeurId String
  schoolId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classe     Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere    Matiere?   @relation(fields: [matiereId], references: [id], onDelete: SetNull)
  professeur Professeur @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  devoir     Devoir[]

  @@index([classeId, date])
  @@index([professeurId])
}

model Devoir {
  id            String   @id @default(uuid())
  titre         String
  description   String?  @db.Text
  dateRendu     String
  cahierTexteId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cahierTexte CahierTexte @relation(fields: [cahierTexteId], references: [id], onDelete: Cascade)

  @@index([cahierTexteId])
}

model Quiz {
  id           String     @id @default(uuid())
  titre        String
  classeId     String
  matiereId    String?
  professeurId String
  schoolId     String
  statut       StatutQuiz @default(BROUILLON)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  classe      Classe       @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere     Matiere?     @relation(fields: [matiereId], references: [id], onDelete: SetNull)
  professeur  Professeur   @relation(fields: [professeurId], references: [id], onDelete: Cascade)
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  questions   Question[]
  soumissions Soumission[]

  @@index([classeId])
  @@index([professeurId])
}

model Question {
  id           String       @id @default(uuid())
  quizId       String
  enonce       String       @db.Text
  type         TypeQuestion
  options      String[]
  bonneReponse String
  ordre        Int          @default(0)
  createdAt    DateTime     @default(now())

  quiz     Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  reponses Reponse[]

  @@index([quizId])
}

model Soumission {
  id       String   @id @default(uuid())
  quizId   String
  eleveId  String
  score    Float?
  total    Int
  soumisAt DateTime @default(now())

  quiz     Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  eleve    Eleve     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  reponses Reponse[]

  @@unique([quizId, eleveId])
}

model Reponse {
  id           String   @id @default(uuid())
  soumissionId String
  questionId   String
  valeur       String
  correcte     Boolean?

  soumission Soumission @relation(fields: [soumissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([soumissionId, questionId])
}

model BulletinTemplate {
  id       String @id @default(uuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  config   Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

enum DeliberationStatut {
  BROUILLON
  VALIDEE
}

enum DecisionPassage {
  PASSE
  REDOUBLE
  ORIENTE
  EXCLU
}

enum MentionDeliberation {
  AUCUNE
  ENCOURAGEMENT
  TABLEAU_HONNEUR
  FELICITATIONS
}

enum AvertissementDeliberation {
  AUCUN
  TRAVAIL
  CONDUITE
  RETARDS
  DISCIPLINE
  GENERAL
}

model DeliberationSession {
  id            String @id @default(uuid())
  classeId      String
  classe        Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)
  schoolId      String
  school        School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodeLabel  String
  anneeScolaire String

  // -- Lien optionnel vers la Periode formelle (pour récupérer les notes par périodeId)
  periodeId String?
  periode   Periode? @relation(fields: [periodeId], references: [id], onDelete: SetNull)

  statut      DeliberationStatut @default(BROUILLON)
  compteRendu String?

  createdById String
  createdBy   User   @relation("DelibCreatedBy", fields: [createdById], references: [id])

  validatedAt   DateTime?
  validatedById String?
  validatedBy   User?     @relation("DelibValidatedBy", fields: [validatedById], references: [id])

  decisions DeliberationDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classeId, periodeLabel, anneeScolaire])
  @@index([schoolId])
  @@index([classeId])
  @@index([statut])
  @@index([periodeId])
}

model DeliberationDecision {
  id        String              @id @default(uuid())
  sessionId String
  session   DeliberationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  decision      DecisionPassage
  mention       MentionDeliberation       @default(AUCUNE)
  avertissement AvertissementDeliberation @default(AUCUN)
  commentaire   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, eleveId])
  @@index([sessionId])
  @@index([eleveId])
}

enum ExamenStatut {
  PLANIFIE
  EN_COURS
  TERMINE
  REPORTE
  ANNULE
}

model ExamenSalle {
  id       String  @id @default(uuid())
  nom      String
  capacite Int?
  location String?
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sessions ExamenSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, nom])
  @@index([schoolId])
}

model ExamenSession {
  id          String  @id @default(uuid())
  titre       String
  description String?

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  salleId String?
  salle   ExamenSalle? @relation(fields: [salleId], references: [id], onDelete: SetNull)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  dateExamen String
  heureDebut String
  heureFin   String
  statut     ExamenStatut @default(PLANIFIE)

  createdById String
  createdBy   User   @relation("ExamensCrees", fields: [createdById], references: [id])

  surveillants ExamenSurveillance[]
  incidents    ExamenIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classeId, dateExamen])
  @@index([statut])
}

model ExamenSurveillance {
  id String @id @default(uuid())

  sessionId String
  session   ExamenSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ExamenSurveilles", fields: [userId], references: [id])

  roleLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
}

model ExamenIncident {
  id String @id @default(uuid())

  sessionId String
  session   ExamenSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type    String
  message String

  createdById String
  createdBy   User   @relation("ExamenIncidentsCrees", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// MODEL SIGNATURE
model Signature {
  id        String   @id @default(uuid())
  userId    String   @unique // une signature active par utilisateur
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filePath  String // Chemin local du fichier
  mimeType  String // image/png ou image/jpeg
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MODULE CHAPITRE
enum StatutChapitre {
  A_FAIRE
  EN_COURS
  FAIT
}

model Chapitre {
  id     String         @id @default(uuid())
  titre  String
  ordre  Int            @default(0)
  statut StatutChapitre @default(A_FAIRE)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sousChapitres SousChapitre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classeId, matiereId])
}

model SousChapitre {
  id     String         @id @default(uuid())
  titre  String
  ordre  Int            @default(0)
  statut StatutChapitre @default(A_FAIRE)

  chapitreId String
  chapitre   Chapitre @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapitreId])
}

// ==========================================
// MODULE LOGISTIQUE : INVENTAIRE DES LOCAUX
// ==========================================

model Batiment {
  id          String  @id @default(uuid())
  nom         String // Ex: "Bâtiment A", "Pavillon Sciences"
  code        String? // Ex: "BAT-A"
  description String?
  nbEtages    Int     @default(1)

  // Lien direct avec l'école
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  salles    Salle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Salle {
  id            String    @id @default(uuid())
  nom           String // Ex: "Salle 204", "Laboratoire Chimie B"
  code          String? // Ex: "S-204"
  type          TypeSalle @default(COURS)
  etage         Int       @default(0) // 0 = RDC, 1 = 1er étage, etc.
  capacite      Int // Nombre de places assises max
  pmrAccessible Boolean   @default(true)

  // Équipements fixes (ex: {"videoprojecteur": true, "ordinateurs": 15})
  equipements Json?       @default("{}")
  statut      StatutSalle @default(DISPONIBLE)

  // Lien avec le bâtiment
  batimentId String
  batiment   Batiment @relation(fields: [batimentId], references: [id], onDelete: Cascade)

  // ✅ AJOUT : Lien direct avec l'école pour des requêtes ultra-rapides et sécurisées
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Ajout : Lien avec une classe car certaines salles peuvent être réservées pour des classes spécifiques (ex: salle informatique pour la classe 3ème A)
  classeId String?
  classe   Classe? @relation(fields: [classeId], references: [id], onDelete: SetNull)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reservationSalles ReservationSalle[]

  // Indexations stratégiques combinant le schoolId pour la sécurité et la performance
  @@index([schoolId])
  @@index([schoolId, batimentId])
  @@index([schoolId, type])
  @@index([schoolId, statut])
}

// ==========================================
// ENUMS
// ==========================================

enum TypeSalle {
  COURS
  LABO_SCIENCE
  INFORMATIQUE
  AMPHI
  REUNION
  SPORT
  ADMINISTRATIF
  AUTRE
}

enum StatutSalle {
  DISPONIBLE
  MAINTENANCE
  RESERVEE
}

model ReservationSalle {
  id String @id @default(uuid())

  // information de la réservation
  titre       String
  description String?
  dateDebut   DateTime
  dateFin     DateTime

  // Statut de la réservation
  statut StatutReservation @default(EN_ATTENTE)

  // Salle réservée
  salleId String
  salle   Salle  @relation(fields: [salleId], references: [id], onDelete: Cascade)

  // utilisateur qui fait la réservation
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // école
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Motif de refus (si applicable)
  motifRefus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, salleId])
  @@index([schoolId, userId])
  @@index([schoolId, dateDebut, dateFin])
  @@index([schoolId, statut])
}

enum StatutReservation {
  EN_ATTENTE // En attente de validation
  APPROUVEE // approuvée
  REFUSEE // refusée
  ANNULEE // Annulée par l'utilisateur
}

// ==========================================
// MODULE LOGISTIQUE : GESTION DES STOCKS
// ==========================================

enum CategorieArticle {
  FOURNITURES_SCOLAIRES
  MATERIEL_PEDAGOGIQUE
  MATERIEL_INFORMATIQUE
  EQUIPEMENT_SPORTIF
  CONSOMMABLES
  IMMOBILIERS
  AUTRE
}

model ArticleStock {
  id          String           @id @default(uuid())
  nom         String // Ex: "Cahier 96 pages", "Ordinateur portable Dell"
  reference   String? // Ex: "CAH-96", "ORD-Dell-2024"
  description String?          @db.Text
  categorie   CategorieArticle @default(FOURNITURES_SCOLAIRES)

  // Gestion des quantités
  quantite     Int // Quantité actuelle en stock
  unite        String @default("unité") // Ex: "unité", "pièce", "kg", "litre"
  seuilMinimal Int // Seuil minimal pour déclencher une alerte de réapprovisionnement
  seuilOptimal Int? // Seuil optimal pour le stock

  // Gestion financière
  prixUnitaire Decimal? // Prix unitaire d'achat

  emplacement String? // Ex: "Entrepôt A - Étagère 3", "Salle Informatique - Armoire 2"

  // Lien avec l'école
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Historiques des mouvement
  mouvements MouvementStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, categorie])
  @@index([schoolId, quantite])
}

enum TypeMouvement {
  ENTREE // Achat, livraison, retour
  SORTIE // Distribution, consommation, perte
  AJUSTEMENT // correction d'inventaire
  TRANSFERT // Changement d'emplacement ou de catégorie
}

model MouvementStock {
  id       String        @id @default(uuid())
  type     TypeMouvement
  quantite Int // quatité (positif pour entrée, négatif pour sortie)

  // article concerné
  articleId String
  article   ArticleStock @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // Détails du mouvement
  motif     String? // raison du mouvement (ex: "Achat fournisseur", "Distribution aux élèves", "Correction d'inventaire")
  reference String? // bon de commande, bon de livraison, etc.
  cout      Decimal? @db.Decimal(10, 2) // coût total du mouvement (quantité * prix unitaire)

  // utilisateur responsable du mouvement
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // école
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([articleId])
  @@index([schoolId, type])
  @@index([schoolId, createdAt])
}
