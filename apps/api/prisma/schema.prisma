// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Ajout d'énumération des rôles
enum Role {
  SUDO_ADMIN
  ADMIN
  USER
  PROF
  ELEVE
  PARENT
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(USER)

  // Le Sudo_Admin n'a pas de schoolId, les autres OUI.
  schoolId String? // nullable pour le Sudo_Admin
  school   School? @relation(fields: [schoolId], references: [id])
}

// Modele SAAS

model School {
  id        String       @id @default(uuid())
  nom       String
  classes   Classe[]
  eleves    Eleve[]
  profs     Professeur[]
  createdAt DateTime     @default(now())
  users     User[]
}

model Classe {
  id       String       @id @default(uuid())
  nom      String // ex: "6ème A", "5ème B", etc.
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id])
  eleves   Eleve[] // Une classe a plusieurs élèves
  profs    Professeur[] // Une classe a plusieurs professeurs
}

model Eleve {
  id       String @id @default(uuid())
  nom      String
  prenom   String
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  classeId String
  classe   Classe @relation(fields: [classeId], references: [id])
}

model Professeur {
  id       String   @id @default(uuid())
  nom      String
  prenom   String
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  classes  Classe[] // Un professeur peut enseigner dans plusieurs classes
}
